# Optional host port for the API. Its container always listens on port 3000.
API_PORT=3000

# Exact browser origins, separated by commas (scheme and port matter).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# For npm run seed outside Docker; requires a separately accessible MongoDB.
# Compose uses its internal mongodb hostname instead of this value.
MONGODB_URI=mongodb://127.0.0.1:27017/smartlog

# Bounded database query and readiness timeouts, in milliseconds.
QUERY_TIMEOUT_MS=5000
HEALTH_TIMEOUT_MS=2000

# Optional until the analysis engine is invoked. Set the real key only in .env.
GEMINI_API_KEY=
# Set a Gemini model that supports JSON Schema structured output for your account.
GEMINI_MODEL=
ANALYSIS_MODE=synthesis
ANALYSIS_REQUEST_TIMEOUT_MS=30000
ANALYSIS_TOTAL_TIMEOUT_MS=120000
ANALYSIS_CHUNK_BYTES=24000
