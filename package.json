{
  "name": "smartlog-analyzer-abstracta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "start": "node --env-file-if-exists=.env src/server.js",
